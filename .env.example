# Copy this file to ".env" and fill in your Alpaca API keys.
# Get keys from https://app.alpaca.markets (Paper Trading -> API Keys).
#
# IMPORTANT: Keep your real .env file private. Never share it or commit it.

# --- Paper trading keys (used while ALPACA_PAPER=true) ---
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Set to "true" for paper (fake money), "false" for live (real money).
# Leave this TRUE until you have proven the strategy.
ALPACA_PAPER=true
