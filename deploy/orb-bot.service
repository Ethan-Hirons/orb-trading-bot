[Unit]
Description=ORB trading bot (daily session)
After=network-online.target
Wants=network-online.target
OnFailure=orb-alert@%n.service

# Crash-loop guard. These MUST live in [Unit] -- in [Service] systemd logs
# "Unknown key name" and the limit is silently inactive (found 2026-09-20).
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=orb
WorkingDirectory=/opt/orb-bot
ExecStart=/opt/orb-bot/deploy/start.sh

# The bot exits itself after the EOD summary (~15:50 ET). This is a backstop
# in case it ever hangs: 09:25 + 7h30m lands well after the close.
RuntimeMaxSec=27000

# v1.17: run.py installs a SIGTERM/SIGINT handler that asks the runner to
# stop and FLATTENS every open position before exiting, so the default
# `systemctl stop` is now safe mid-session. TimeoutStopSec must be generous
# enough for that flatten (exit_position retries with backoff); if it expires
# systemd SIGKILLs and positions are left open.
KillSignal=SIGTERM
TimeoutStopSec=120

# Mirror the Windows start_bot.ps1 behaviour: restart on crash, up to 5 times.
# (The 5-per-hour limit itself is set in [Unit] above.)
Restart=on-failure
RestartSec=30

StandardOutput=journal
StandardError=journal

# Basic hardening -- the bot only needs its own directory and outbound HTTPS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/orb-bot/logs /opt/orb-bot/state

[Install]
WantedBy=multi-user.target
